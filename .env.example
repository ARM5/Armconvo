# Copy to .env and fill in your own values. Never commit .env.
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password
IG_GROUP_NAME=Your exact Instagram group title
BOT_ADMINS=your_admin_username
POLL_SECONDS=20
WELCOME_ENABLED=true
GROUP_RULES=Be respectful. No spam, harassment or unwanted links.
BOT_DB=group_bot.sqlite3
SESSION_FILE=.ig_session.json
